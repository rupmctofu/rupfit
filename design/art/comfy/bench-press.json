    "_meta": { "title": "Prompt positivo" },
    "inputs": {
      "clip": ["1", 1],
      "text": "flat vector illustration, clean thick outlines, an athlete performing a flat barbell bench press, side view, lying on the bench, both hands gripping the barbell above the chest, knees bent and feet flat on the floor, one single ink colour plus light lilac, plain dark background, no text, no gradients, whole body inside the frame, exercise icon style"
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Prompt negativo" },
    "inputs": {
      "clip": ["1", 1],
      "text": "photo, photorealistic, text, watermark, gradient, extra limbs, deformed hands, cropped head, cropped feet, clutter, multiple people"
    }
  },
  "4": {
